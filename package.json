{
  "name": "omarchy-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "PersonaStack desktop client for Omarchy",
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "npm run build && electron .",
    "test": "npm run build && node --test dist/*.test.js",
    "verify:electron": "electron --version"
  },
  "engines": {
    "node": ">=24.21.0",
    "npm": "11.19.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "npm",
      "version": "11.19.0",
      "onFail": "error"
    }
  },
  "devDependencies": {
    "@types/node": "26.6.3",
    "electron": "44.4.3",
    "typescript": "7.0.2"
  }
}
